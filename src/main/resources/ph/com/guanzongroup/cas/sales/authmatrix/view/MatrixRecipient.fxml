<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Place next to MatrixRecipientDialog.java in resources:
     src/main/resources/ph/com/guanzongroup/cas/sales/authmatrix/MatrixRecipient.fxml
     The stylesheet (matrix-recipient.css) is still added to the DialogPane by MatrixRecipientDialog. -->

<VBox fx:id="rootBox" spacing="10.0" stylesheets="@css/matrix-recipient.css" xmlns="http://javafx.com/javafx/8.0.381" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ph.com.guanzongroup.cas.sales.authmatrix.MatrixRecipientController">
    <padding>
        <Insets top="6.0" />
    </padding>
    <children>
        <HBox fx:id="hbStatusBar" alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label fx:id="lblCaption" styleClass="caption" text="Request Status">
               <HBox.margin>
                  <Insets left="10.0" />
               </HBox.margin></Label>
                <Label fx:id="lblBadge" styleClass="status-badge" />
            </children>
        </HBox>
        <TableView fx:id="tbl" editable="false" fixedCellSize="28.0" prefHeight="150.0" prefWidth="560.0">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colName" text="Approver" />
                <TableColumn fx:id="colSent" maxWidth="100.0" minWidth="100.0" style="-fx-alignment: CENTER;" text="Code Sent" />
                <TableColumn fx:id="colStatus" maxWidth="110.0" minWidth="100.0" style="-fx-alignment: CENTER;" text="Status" />
            <TableColumn fx:id="colApproved" maxWidth="100.0" minWidth="100.0" style="-fx-alignment: CENTER;" text="Approved Date" />
            </columns>
        </TableView>
    </children>
</VBox>
